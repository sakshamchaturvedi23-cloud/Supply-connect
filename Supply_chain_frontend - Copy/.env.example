# ==============================================================================
# Supply Connect — Environment Variables Template
# Copy this file to .env.local and configure your real values.
# Do NOT commit .env or .env.local with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Local Development Auth Bypass
# Set to 'true' to develop and preview all protected routes (/dashboard, /explore,
# /impact-copilot, /chat, /startup-advisor) locally without configuring Supabase OAuth.
#
# IMPORTANT SECURITY RULES:
# - ONLY active when NODE_ENV === 'development' AND DEV_AUTH_BYPASS === 'true'.
# - Completely ignored in production, preview, and test builds (fails closed).
# - Off by default. Set DEV_AUTH_BYPASS=false or remove it to re-enable production auth.
# ------------------------------------------------------------------------------
DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# Required for user authentication, session cookies, and database operations.
# Format:
#   NEXT_PUBLIC_SUPABASE_URL: https://<your-project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY: eyJhbGci... (your project's public anon key)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ------------------------------------------------------------------------------
# Google OAuth Configuration Checklist for Supabase:
# 1. Supabase Dashboard -> Authentication -> Providers -> Google:
#    - Enable Google provider
#    - Client ID: Obtained from Google Cloud Console -> APIs & Services -> Credentials
#    - Client Secret: Obtained from Google Cloud Console
# 2. Supabase Dashboard -> Authentication -> URL Configuration:
#    - Site URL: http://localhost:3000 (or your production domain)
#    - Redirect URLs allowlist:
#        http://localhost:3000/auth/callback
#        http://localhost:3000/**
#        https://<your-production-domain>/auth/callback
# 3. Google Cloud Console -> OAuth 2.0 Client IDs -> Authorized redirect URIs:
#    - Add: https://<your-project-ref>.supabase.co/auth/v1/callback
# ------------------------------------------------------------------------------

# AI Gateway / LLM API Configuration
# Used for Supply AI streaming chat (/api/chat) and Impact Analysis (/api/impact-analysis)
NEXT_PUBLIC_AI_GATEWAY_URL=http://localhost:3001/v1
# Alternative fallback URLs:
# LLM_API_URL=https://your-llm-gateway.example.com/v1

# AI Gateway API Key
FREELLM_API_KEY=<your-llm-api-key>
# Alternative key name:
# LLM_API_KEY=<your-llm-api-key>

# Google Generative AI (Gemini)
# Used by RSS ingestion pipeline to analyze and categorize live news articles
GEMINI_API_KEY=<your-gemini-api-key>

# Optional Model Overrides (comma-separated, attempted in order)
# IMPACT_MODELS=auto,gemini-1.5-pro,gemini-1.5-flash
# BRIEF_MODELS=auto,gemini-1.5-flash
